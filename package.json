{
  "name": "lilac-ember",
  "displayName": "Lilac Ember",
  "description": "A dark VS Code theme with a soft lilac, pink, orange, and green color palette.",
  "version": "0.1.2",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Lilac Ember",
        "uiTheme": "vs-dark",
        "path": "./themes/Lilac Ember-color-theme.json"
      }
    ],
    "grammars": [
      {
        "path": "./syntaxes/typescript-void.tmLanguage.json",
        "scopeName": "typescript.void.injection",
        "injectTo": [
          "source.ts"
        ]
      },
      {
        "path": "./syntaxes/typescript-methods.tmLanguage.json",
        "scopeName": "source.ts.lilac-ember",
        "injectTo": [
          "source.ts",
          "source.tsx"
        ]
      }
    ]
  }
}
