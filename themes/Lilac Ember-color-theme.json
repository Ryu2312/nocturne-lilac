{
  "name": "Lilac Ember",
  "type": "dark",
  "semanticHighlighting": false,

  "colors": {
    "editor.background": "#1A1A1A",
    "editor.foreground": "#EDEDED",
    "editorCursor.foreground": "#EDEDED",

    "editorGutter.modifiedBackground": "#858585",
    "editorGutter.addedBackground": "#9A9A9A",
    "editorGutter.deletedBackground": "#707070",
    "editorLineNumber.foreground": "#555555",
    "editorLineNumber.activeForeground": "#EDEDED",
    "editor.selectionBackground": "#555555",
    "editorGutter.background": "#1A1A1A",

    "editorBracketHighlight.foreground1": "#EDEDED",
    "editorBracketHighlight.foreground2": "#EDEDED",
    "editorBracketHighlight.foreground3": "#EDEDED",
    "editorBracketHighlight.foreground4": "#EDEDED",
    "editorBracketHighlight.foreground5": "#EDEDED",
    "editorBracketHighlight.foreground6": "#EDEDED",
    "editorBracketHighlight.unexpectedBracket.foreground": "#EDEDED",

    "focusBorder": "#D0D3D8",

    "titleBar.activeBackground": "#1A1A1A",
    "titleBar.activeForeground": "#EDEDED",
    "titleBar.inactiveBackground": "#1A1A1A",
    "titleBar.inactiveForeground": "#808080",
    "titleBar.border": "#303030",

    "commandCenter.background": "#1A1A1A",
    "commandCenter.foreground": "#EDEDED",
    "commandCenter.border": "#303030",
    "commandCenter.activeBackground": "#252525",
    "commandCenter.activeForeground": "#EDEDED",
    "commandCenter.activeBorder": "#B897F4",

    "input.background": "#1A1A1A",
    "input.border": "#303030",
    "input.foreground": "#EDEDED",
    "input.placeholderForeground": "#808080",

    "widget.border": "#303030",
    "widget.shadow": "#000000",

    "sideBar.background": "#1A1A1A",
    "sideBar.foreground": "#c9caca",
    "sideBar.border": "#303030",

    "sideBarTitle.background": "#1A1A1A",
    "sideBarTitle.foreground": "#D0D3D8",
    "sideBarTitle.border": "#303030",

    "sideBarSectionHeader.background": "#1A1A1A",
    "sideBarSectionHeader.foreground": "#EDEDED",
    "sideBarSectionHeader.border": "#303030",

    "list.activeSelectionBackground": "#303030",
    "list.activeSelectionForeground": "#EDEDED",
    "list.inactiveSelectionBackground": "#252525",
    "list.inactiveSelectionForeground": "#D0D3D8",
    "list.focusBackground": "#303030",
    "list.focusForeground": "#EDEDED",
    "list.hoverBackground": "#252525",
    "list.hoverForeground": "#EDEDED",

    "editorGroup.border": "#303030",
    "editorGroupHeader.tabsBorder": "#303030",
    "editorGroupHeader.border": "#303030",

    "tab.border": "#303030",

    "gitDecoration.addedResourceForeground": "#D0D3D8",
    "gitDecoration.modifiedResourceForeground": "#D0D3D8",
    "gitDecoration.untrackedResourceForeground": "#D0D3D8"
  },

  "tokenColors": [
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F8A6C8"
      }
    },

    {
      "scope": [
        "support.type",
        "support.type.primitive",
        "support.type.primitive.ts",
        "support.type.builtin",
        "support.type.builtin.ts",
        "entity.name.type",
        "entity.name.type.ts",
        "entity.name.type.class.ts",
        "entity.name.type.interface.ts",
        "entity.name.type.js",
        "entity.name.type.class.js",
        "entity.name.type.interface.js",
        "entity.name.type.js.jsx",
        "entity.name.type.class.js.jsx",
        "entity.name.type.interface.js.jsx"
      ],
      "settings": {
        "foreground": "#B897F4"
      }
    },

    {
      "scope": "support.type.void",
      "settings": {
        "foreground": "#F8A6C8"
      }
    },

    {
      "scope": [
        "meta.class.ts entity.name.type.class.ts",
        "meta.class.js entity.name.type.class.js",
        "meta.class.js.jsx entity.name.type.class.js.jsx"
      ],
      "settings": {
        "foreground": "#F1A275"
      }
    },

    {
      "scope": [
        "entity.name.type.class.ts",
        "entity.name.type.ts",
        "entity.name.class",
        "entity.other.inherited-class.ts",
        "support.class",
        "support.class.ts",
        "entity.name.type.class.js",
        "entity.name.type.js",
        "entity.other.inherited-class.js",
        "support.class.js",
        "entity.name.type.class.js.jsx",
        "entity.name.type.js.jsx",
        "entity.other.inherited-class.js.jsx",
        "support.class.js.jsx"
      ],
      "settings": {
        "foreground": "#B897F4"
      }
    },

    {
      "scope": [
        "new.expr.ts meta.function-call.ts entity.name.function.ts",
        "new.expr.tsx meta.function-call.tsx entity.name.function.tsx",
        "new.expr.js meta.function-call.js entity.name.function.js",
        "new.expr.js.jsx meta.function-call.js.jsx entity.name.function.js.jsx"
      ],
      "settings": {
        "foreground": "#F1A275"
      }
    },

    {
      "scope": [
        "meta.definition.function.ts entity.name.function.ts",
        "entity.name.function.ts",
        "entity.name.function",
        "meta.definition.function.js entity.name.function.js",
        "entity.name.function.js",
        "meta.definition.function.js.jsx entity.name.function.js.jsx",
        "entity.name.function.js.jsx"
      ],
      "settings": {
        "foreground": "#B897F4"
      }
    },

    {
      "scope": [
        "meta.definition.method.ts entity.name.function.ts",
        "meta.definition.method.js entity.name.function.js",
        "meta.definition.method.js.jsx entity.name.function.js.jsx"
      ],
      "settings": {
        "foreground": "#EDEDED"
      }
    },

    {
      "scope": [
        "variable.other.readwrite",
        "variable.other.readwrite.ts",
        "variable.other.constant",
        "variable.other.constant.ts",
        "variable.other.object.ts",
        "variable.other.constant.object.ts",
        "variable.other.object.tsx",
        "variable.other.constant.object.tsx",
        "variable.other.readwrite.js",
        "variable.other.constant.js",
        "variable.other.object.js",
        "variable.other.constant.object.js",
        "variable.other.readwrite.js.jsx",
        "variable.other.constant.js.jsx",
        "variable.other.object.js.jsx",
        "variable.other.constant.object.js.jsx"
      ],
      "settings": {
        "foreground": "#BDA0F1"
      }
    },

    {
      "scope": [
        "variable.other.object.ts",
        "variable.other.constant.object.ts",
        "variable.other.object.tsx",
        "variable.other.constant.object.tsx",
        "variable.other.object.js",
        "variable.other.constant.object.js",
        "variable.other.object.js.jsx",
        "variable.other.constant.object.js.jsx"
      ],
      "settings": {
        "foreground": "#B897F4"
      }
    },

    {
      "scope": [
        "variable.parameter",
        "variable.parameter.ts",
        "variable.parameter.js",
        "variable.parameter.js.jsx"
      ],
      "settings": {
        "foreground": "#BDA0F1"
      }
    },

    {
      "scope": [
        "variable.other.property",
        "variable.other.property.ts",
        "variable.other.constant.property.ts",
        "variable.other.object.property.ts",
        "variable.other.constant.object.property.ts",
        "variable.object.property.ts",
        "meta.definition.property.ts variable.object.property.ts",
        "meta.object-literal.key.ts",
        "support.variable.property.ts",
        "variable.other.property.js",
        "variable.other.constant.property.js",
        "variable.other.object.property.js",
        "variable.other.constant.object.property.js",
        "variable.object.property.js",
        "meta.definition.property.js variable.object.property.js",
        "meta.object-literal.key.js",
        "support.variable.property.js",
        "variable.other.property.js.jsx",
        "variable.other.constant.property.js.jsx",
        "variable.other.object.property.js.jsx",
        "variable.other.constant.object.property.js.jsx",
        "variable.object.property.js.jsx",
        "meta.definition.property.js.jsx variable.object.property.js.jsx",
        "meta.object-literal.key.js.jsx",
        "support.variable.property.js.jsx"
      ],
      "settings": {
        "foreground": "#EDEDED"
      }
    },

    {
      "scope": [
        "meta.method.declaration.ts > storage.type.ts",
        "meta.method.declaration.js > storage.type.js",
        "meta.method.declaration.js.jsx > storage.type.js.jsx"
      ],
      "settings": {
        "foreground": "#EDEDED"
      }
    },

    {
      "scope": [
        "keyword.operator.new",
        "keyword.operator.new.ts",
        "keyword.operator.instanceof",
        "keyword.operator.expression.instanceof",
        "keyword.operator.assignment",
        "keyword.operator.assignment.ts",
        "keyword.operator.arithmetic",
        "keyword.operator.arithmetic.ts",
        "keyword.operator.logical",
        "keyword.operator.logical.ts",
        "keyword.operator.relational.ts",
        "keyword.operator.relational.tsx",
        "keyword.operator.expression.void.ts",
        "keyword.operator.new.js",
        "keyword.operator.instanceof.js",
        "keyword.operator.expression.instanceof.js",
        "keyword.operator.assignment.js",
        "keyword.operator.arithmetic.js",
        "keyword.operator.logical.js",
        "keyword.operator.relational.js",
        "keyword.operator.new.js.jsx",
        "keyword.operator.instanceof.js.jsx",
        "keyword.operator.expression.instanceof.js.jsx",
        "keyword.operator.assignment.js.jsx",
        "keyword.operator.arithmetic.js.jsx",
        "keyword.operator.logical.js.jsx",
        "keyword.operator.relational.js.jsx"
      ],
      "settings": {
        "foreground": "#F8A6C8"
      }
    },

    {
      "scope": "keyword.operator.type.annotation.ts",
      "settings": {
        "foreground": "#EDEDED"
      }
    },

    {
      "scope": [
        "punctuation.definition.typeparameters",
        "punctuation.definition.typeparameters.begin.ts",
        "punctuation.definition.typeparameters.end.ts",
        "meta.type.parameters.ts"
      ],
      "settings": {
        "foreground": "#EDEDED"
      }
    },

    {
      "scope": [
        "variable.language.super",
        "variable.language.super.ts",
        "variable.language.this",
        "variable.language.this.ts",
        "variable.language.super.js",
        "variable.language.this.js",
        "variable.language.super.js.jsx",
        "variable.language.this.js.jsx"
      ],
      "settings": {
        "foreground": "#F1A275"
      }
    },

    {
      "scope": [
        "entity.name.import",
        "variable.other.import",
        "support.type.import"
      ],
      "settings": {
        "foreground": "#BDA0F1"
      }
    },

    {
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.template",
        "string.template",
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end",
        "punctuation.definition.string.begin.ts",
        "punctuation.definition.string.end.ts",
        "punctuation.definition.string.template.begin.ts",
        "punctuation.definition.string.template.end.ts",
        "punctuation.definition.string.begin.js",
        "punctuation.definition.string.end.js",
        "punctuation.definition.string.template.begin.js",
        "punctuation.definition.string.template.end.js",
        "punctuation.definition.string.begin.js.jsx",
        "punctuation.definition.string.end.js.jsx",
        "punctuation.definition.string.template.begin.js.jsx",
        "punctuation.definition.string.template.end.js.jsx"
      ],
      "settings": {
        "foreground": "#83D19B"
      }
    },

    {
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded",
        "punctuation.section.embedded.ts",
        "punctuation.section.embedded.js",
        "punctuation.section.embedded.js.jsx",
        "punctuation.section.embedded.tsx"
      ],
      "settings": {
        "foreground": "#EDEDED"
      }
    },

    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#F1A275"
      }
    },

    {
      "scope": [
        "constant.language.boolean",
        "constant.language.boolean.true.ts",
        "constant.language.boolean.false.ts",
        "constant.language.null",
        "constant.language.null.ts",
        "constant.language.boolean.true.js",
        "constant.language.boolean.false.js",
        "constant.language.null.js",
        "constant.language.boolean.true.js.jsx",
        "constant.language.boolean.false.js.jsx",
        "constant.language.null.js.jsx"
      ],
      "settings": {
        "foreground": "#F1A275"
      }
    },

    {
      "scope": [
        "constant.language.undefined",
        "constant.language.undefined.ts",
        "constant.language.undefined.js",
        "constant.language.undefined.js.jsx"
      ],
      "settings": {
        "foreground": "#BDA0F1"
      }
    },

    {
      "scope": [
        "support.class.console",
        "support.variable.console",
        "support.object.console",
        "variable.language.console",
        "support.class.console.ts",
        "support.variable.console.ts",
        "support.object.console.ts",
        "variable.language.console.ts",
        "support.class.console.tsx",
        "support.variable.console.tsx",
        "support.object.console.tsx",
        "variable.language.console.tsx",
        "support.class.console.js",
        "support.variable.console.js",
        "support.object.console.js",
        "variable.language.console.js",
        "support.class.console.js.jsx",
        "support.variable.console.js.jsx",
        "support.object.console.js.jsx",
        "variable.language.console.js.jsx"
      ],
      "settings": {
        "foreground": "#B897F4"
      }
    },

    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#EDEDED"
      }
    },

    {
      "scope": [
        "punctuation.definition.comment.ts",
        "punctuation.definition.comment.json.comments",
        "punctuation.definition.comment.js",
        "punctuation.definition.comment.js.jsx"
      ],
      "settings": {
        "foreground": "#808080"
      }
    },

    {
      "scope": [
        "string.regexp",
        "string.regexp.ts",
        "string.regexp.js",
        "string.regexp.js.jsx",

        "punctuation.definition.group",
        "punctuation.definition.character-class",
        "punctuation.definition.group.regexp",
        "punctuation.definition.group.assertion.regexp",
        "punctuation.definition.character-class.regexp",
        "punctuation.character.set.begin.regexp",
        "punctuation.character.set.end.regexp",
        "support.other.parenthesis.regexp",

        "keyword.operator.negation.regexp",
        "keyword.operator.or.regexp",
        "keyword.operator.quantifier.regexp",
        "keyword.control.anchor.regexp",

        "constant.character.character-class.regexp",
        "constant.other.character-class.set.regexp",
        "constant.other.character-class.regexp",
        "constant.character.set.regexp",
        "constant.other.option",
        "constant.character.escape",

        "string.regexp.ts keyword",
        "string.regexp.ts punctuation",
        "string.regexp.ts constant",
        "string.regexp.ts variable",
        "string.regexp.ts meta",
        "string.regexp.ts support",

        "string.regexp.ts keyword.operator.logical.ts",
        "string.regexp.js keyword",
        "string.regexp.js punctuation",
        "string.regexp.js constant",
        "string.regexp.js variable",
        "string.regexp.js meta",
        "string.regexp.js support",
        "string.regexp.js.jsx keyword",
        "string.regexp.js.jsx punctuation",
        "string.regexp.js.jsx constant",
        "string.regexp.js.jsx variable",
        "string.regexp.js.jsx meta",
        "string.regexp.js.jsx support"
      ],
      "settings": {
        "foreground": "#83D19B"
      }
    },

    {
      "scope": "support.type.property-name.json",
      "settings": {
        "foreground": "#EDEDED"
      }
    },

    {
      "scope": "constant.language.json",
      "settings": {
        "foreground": "#F1A275"
      }
    },

    {
      "scope": "comment",
      "settings": {
        "foreground": "#808080"
      }
    },

    {
      "scope": [
        "punctuation.decorator.ts",
        "punctuation.decorator.js",
        "punctuation.decorator.js.jsx"
      ],
      "settings": {
        "foreground": "#8FB8E8"
      }
    },
    {
      "scope": "entity.name.function.member.custom",
      "settings": {
        "foreground": "#EDEDED"
      }
    }
  ]
}
